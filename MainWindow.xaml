<Window x:Class="SystemAutomationTesting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemAutomationTesting"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1920">
    <Grid>
        <!-- Define two rows: one for the scrollable content and one for the button -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Scrollable content -->
            <RowDefinition Height="Auto" />
            <!-- Button -->
        </Grid.RowDefinitions>
        <TabControl ItemsSource="{Binding Tests}" Grid.Row="0">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <!-- Bind the Tab Header to the TestName property -->
                    <TextBlock Text="{Binding TestName}" FontSize="24" FontWeight="Bold" TextAlignment="Center" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <StackPanel>
                        <CheckBox Content="Select Test" IsChecked="{Binding Checkbox.IsChecked, Mode=TwoWay}" FontSize="16" Margin="10" />
                        <CheckBox Content="Ping Devices" IsChecked="{Binding PingDevicesCheckbox.IsChecked, Mode=TwoWay}" FontSize="16" Margin="10">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPingDevicesCheckbox}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <Grid>
                            <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" CanUserAddRows="False" HorizontalAlignment="Stretch" MaxHeight="800">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device Index" Binding="{Binding DeviceIndex}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Device Type" Binding="{Binding DeviceType}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <!-- Buttons in Row 1 -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <!-- For the buttons -->
                <ColumnDefinition Width="*" />
                <!-- For the ProgressBar -->
            </Grid.ColumnDefinitions>

            <!-- Buttons -->
            <Button Content="Run All Tests" Width="150" Height="30" FontSize="16" FontWeight="Bold" Margin="5,0" 
                Command="{Binding RunAllTestsCommand}" Grid.Column="0" />
            <Button Content="Run Selected Tests" Width="150" Height="30" FontSize="16" FontWeight="Bold" Margin="5,0" 
                Command="{Binding ProcessSelectedCommand}" Grid.Column="1" />


            <!-- ProgressBar -->
            <ProgressBar Name="ProgressBar" Height="30" Margin="5,0" 
                 HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                 Minimum="0" Maximum="100" Value="50" Grid.Column="2" />
        </Grid>
    </Grid>
</Window>
