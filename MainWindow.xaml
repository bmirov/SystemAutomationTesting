<Window x:Class="SystemAutomationTesting.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemAutomationTesting"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1920">
    <Grid>
        <!-- Define two rows: one for the scrollable content and one for the button -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <!-- Scrollable content -->
            <RowDefinition Height="Auto" />
            <!-- Button -->
        </Grid.RowDefinitions>
        <TabControl Grid.Row="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- First Tab -->
            <TabItem Header="Test 1">
                <Grid>
                    <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" CanUserAddRows="False" HorizontalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device Index" Binding="{Binding DeviceIndex}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Device Type" Binding="{Binding DeviceType}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Test 2">
                <Grid>
                    <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" CanUserAddRows="False" HorizontalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device Index" Binding="{Binding DeviceIndex}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Device Type" Binding="{Binding DeviceType}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <!-- Buttons in Row 1 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
            <Button Content="Run All Tests" Width="150" Height="50" FontSize="16" FontWeight="Bold" Margin="5,0" />
            <Button Content="Run Selected Tests" Width="150" Height="50" FontSize="16" FontWeight="Bold" Margin="5,0" />
        </StackPanel>
    </Grid>
</Window>
